# CronTab unter macOS anlegen

crontab -e

# Eintrag im CronTab (stuendlich, jeweils zur vollen Stunde).
# Pfad an die eigene Installation anpassen.

0 * * * * /usr/bin/python3 "$HOME/CronTabs/ScreenshotHandler/screenshothandler.py"

# Nach dem Eintrag mit "ESC" den Editormodus verlassen,
# mit ":wq" sichern.

# CronTab pruefen
crontab -l

# Hinweis: Unter aktuellen macOS-Versionen benoetigt cron die Berechtigung
# "Festplattenvollzugriff", um auf ~/Desktop zugreifen zu duerfen:
# Systemeinstellungen -> Datenschutz & Sicherheit -> Festplattenvollzugriff
